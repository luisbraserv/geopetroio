<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="180.0" prefWidth="420.0" spacing="18.0" style="-fx-background-color: #ffffff;" stylesheets="@geopetro-design-system.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controllers.PumpSettingsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Configuracao da Bomba">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <VBox spacing="6.0">
         <children>
            <Label text="Constante da Bomba (BBL/stroke)" />
            <TextField fx:id="txtPumpConstant" promptText="Ex.: 0.125" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnCancel" mnemonicParsing="false" prefWidth="90.0" text="Cancelar" />
            <Button fx:id="btnSave" mnemonicParsing="false" prefWidth="90.0" style="-fx-background-color: #051833; -fx-background-radius: 5; -fx-text-fill: white;" text="Salvar" />
         </children>
      </HBox>
   </children>
</VBox>
