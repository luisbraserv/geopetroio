<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: #f7f9fc; -fx-background: #f7f9fc;"
            stylesheets="@geopetro-design-system.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.ChaveSettingsController">

   <content>
      <VBox spacing="16.0" style="-fx-background-color: #f7f9fc; -fx-padding: 24;">
         <children>

            <Label fx:id="lblTitulo" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #051833;" text="Configuração da Chave" />

            <!-- Sensor de pressão -->
            <VBox spacing="12.0" style="-fx-background-color: #f0fdf4; -fx-padding: 14; -fx-background-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #166534;" text="Sensor de Pressão" />

                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Limite do sensor (bar):" />
                     <TextField fx:id="txtRangeBar" promptText="Ex: 400" style="-fx-font-size: 14; -fx-padding: 6 10;" />
                  </VBox>

                  <VBox spacing="6.0">
                     <HBox spacing="8.0">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Sensibilidade:" />
                        <Label fx:id="lblSensibilidade" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #154a7a;" text="1.00" />
                     </HBox>
                     <Slider fx:id="sliderSensibilidade"
                             min="0.5" max="1.5" value="1.0"
                             majorTickUnit="0.25" minorTickCount="4"
                             blockIncrement="0.01"
                             showTickLabels="true" showTickMarks="true" />
                     <Label style="-fx-font-size: 11; -fx-text-fill: #5a667a;" text="PSI ajustado = PSI bruto × sensibilidade" />
                  </VBox>
               </children>
            </VBox>

            <Separator />

            <!-- Parâmetros da chave -->
            <VBox spacing="12.0" style="-fx-background-color: #e0f2fe; -fx-padding: 14; -fx-background-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0369a1;" text="Parâmetros da Chave" />

                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Diâmetro do pistão do cilindro (in):" />
                     <TextField fx:id="txtDiametroPistaoIn" promptText="Ex: 2.0" style="-fx-font-size: 14; -fx-padding: 6 10;" />
                  </VBox>

                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Diâmetro da haste do cilindro (in):" />
                     <TextField fx:id="txtDiametroHasteIn" promptText="Ex: 1.0" style="-fx-font-size: 14; -fx-padding: 6 10;" />
                  </VBox>

                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Comprimento do braço da chave (ft):" />
                     <TextField fx:id="txtBracoFt" promptText="Ex: 2.0" style="-fx-font-size: 14; -fx-padding: 6 10;" />
                  </VBox>

                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12; -fx-text-fill: #061c39;" text="Movimento utilizado no aperto:" />
                     <ComboBox fx:id="cmbTipoMovimento" promptText="Selecione Avanço ou Recuo"
                               maxWidth="Infinity" style="-fx-font-size: 14;" />
                  </VBox>
               </children>
            </VBox>

            <Separator />

            <!-- Área e torque calculados (somente leitura) -->
            <VBox spacing="8.0">
               <HBox spacing="6.0" alignment="CENTER_LEFT">
                  <Label style="-fx-font-size: 13; -fx-text-fill: #061c39;" text="Área hidráulica utilizada (in²):" />
                  <Label style="-fx-font-size: 12; -fx-text-fill: #5a667a;" text="ⓘ">
                     <tooltip>
                        <Tooltip text="Avanço: A = π × Dp² / 4&#10;Recuo: A = π × (Dp² - Dh²) / 4" wrapText="true" maxWidth="260" />
                     </tooltip>
                  </Label>
               </HBox>
               <Label fx:id="lblAreaHidraulica" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #154a7a;" text="—" />
               <Label style="-fx-font-size: 11; -fx-text-fill: #5a667a;" text="T = pressão efetiva no cilindro × área hidráulica × braço   →   lbf·ft" wrapText="true" />
            </VBox>

            <Label fx:id="lblValidacao" text="Configuração hidráulica da chave incompleta."
                   wrapText="true"
                   style="-fx-font-size: 12; -fx-text-fill: #b42318; -fx-font-weight: bold; -fx-background-color: #fff5f5; -fx-padding: 8; -fx-background-radius: 6;" />

            <Label fx:id="lblStatus" wrapText="true"
                   style="-fx-font-size: 12; -fx-text-fill: #154a7a;" />

            <!-- Botões -->
            <HBox spacing="12.0">
               <Button fx:id="btnSalvar" onAction="#onSalvar" text="Salvar"
                       prefWidth="120" prefHeight="36"
                       style="-fx-background-color: #051833; -fx-text-fill: white; -fx-font-size: 13; -fx-background-radius: 5;" />
               <Button onAction="#onCancelar" text="Cancelar"
                       prefWidth="100" prefHeight="36"
                       style="-fx-background-color: #ffffff; -fx-border-color: #d6deeb; -fx-text-fill: #051833; -fx-font-size: 13; -fx-background-radius: 5; -fx-border-radius: 5;" />
            </HBox>

         </children>
         <padding><Insets bottom="16.0" /></padding>
      </VBox>
   </content>
</ScrollPane>
