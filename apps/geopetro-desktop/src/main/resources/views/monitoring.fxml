<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.geopetro.desktop.controllers.DashboardGrid?>
<VBox minHeight="0" minWidth="0" stylesheets="@geopetro-design-system.css"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.geopetro.desktop.controllers.MonitoringController">
 <Label fx:id="estadoMonitoramento" wrapText="true" styleClass="ajuda" />
 <DashboardGrid fx:id="cardsPane" VBox.vgrow="ALWAYS" />
 <HBox fx:id="paginas" alignment="CENTER" spacing="10" visible="false" managed="false">
  <Button text="‹" onAction="#paginaAnterior" />
  <Label fx:id="numeroPagina" />
  <Button text="›" onAction="#proximaPagina" />
 </HBox>
</VBox>