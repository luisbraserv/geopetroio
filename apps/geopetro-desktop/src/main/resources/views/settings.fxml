<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
   Configuracoes em duas colunas.

   Cabecalho e rodape ficam fixos e so o miolo rola. Com os botoes dentro da area rolavel, "Salvar"
   saia de vista assim que a janela encolhia, e o usuario precisava rolar ate o fim para salvar.

   As duas colunas viram uma quando a janela fica estreita. Quem faz isso e o SettingsController,
   observando a largura: FXML nao tem media query.
-->
<BorderPane fx:id="raiz" prefWidth="920.0" prefHeight="660.0"
            stylesheets="@settings.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.geopetro.desktop.controllers.SettingsController">

   <top>
      <VBox spacing="2.0" styleClass="cabecalho">
         <Label text="Configurações" styleClass="cabecalho-titulo" />
         <Label text="Ajustes desta estação. As alterações passam a valer ao salvar."
                styleClass="cabecalho-subtitulo" />

         <!-- O que altera o que a unidade le e publica exige ADMIN ou SUPORTE. -->
         <HBox fx:id="faixaPortao" spacing="10.0" alignment="CENTER_LEFT" visible="false" managed="false">
            <padding><Insets top="10.0" /></padding>
            <Label fx:id="lblPortao" styleClass="aviso-configuracao" wrapText="true"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            <Button fx:id="btnDesbloquear" text="Entrar para configurar" />
         </HBox>
      </VBox>
   </top>

   <center>
      <ScrollPane fx:id="rolagem" fitToWidth="true" styleClass="area-rolagem"
                  hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
         <GridPane fx:id="grade" hgap="16.0" vgap="16.0">
            <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0" /></padding>

            <columnConstraints>
               <ColumnConstraints fx:id="coluna1" percentWidth="50.0" />
               <ColumnConstraints fx:id="coluna2" percentWidth="50.0" />
            </columnConstraints>

            <!-- ================= Equipamento ================= -->
            <VBox fx:id="cartaoEquipamento" spacing="12.0" styleClass="cartao"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">
               <Label text="Equipamento" styleClass="cartao-titulo" />

               <!--
                  A Unidade vem ANTES da conexao de proposito: a conexao mora no documento
                  daquela unidade, e sem ela escolhida nao ha o que ler nem onde gravar.
               -->
               <VBox spacing="5.0">
                  <Label text="Unidade desta estação" styleClass="rotulo" />
                  <HBox spacing="8.0">
                     <ComboBox fx:id="cmbUnidadeSonda" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                               promptText="Escolha a Unidade" />
                     <Button fx:id="btnRecarregar" text="Buscar" styleClass="botao-secundario" />
                  </HBox>
                  <Label fx:id="lblUnidadeStatus" styleClass="ajuda" />
                  <Label styleClass="ajuda"
                         text="A lista vem do cadastro do Backend. Escolher aqui define de uma vez o endereço do histórico e o do tempo real, que antes eram dois campos separados." />
               </VBox>

               <Separator />

               <!--
                  Conexao com o CLP — configuracao-da-estacao.md §4. Saiu da tela de Cards e veio
                  para ca inteira: IP, rack, slot, DB e intervalo. E por ela que o PLC conecta.
               -->
               <Label text="Conexão com o CLP" styleClass="cartao-titulo" />
               <Label styleClass="cartao-nota"
                      text="Fica guardada na Unidade, não nesta estação: rack, slot, DB e intervalo descrevem o modelo de CLP e são copiados ao configurar uma sonda igual." />

               <VBox spacing="5.0">
                  <Label text="IP do PLC" styleClass="rotulo" />
                  <TextField fx:id="txtPlcIp" promptText="Ex.: 192.168.0.10" maxWidth="Infinity" />
                  <Label styleClass="ajuda"
                         text="O IP não é copiado entre unidades: ele diz qual CLP, não o modelo dele." />
               </VBox>

               <HBox spacing="10.0">
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label text="Rack" styleClass="rotulo" />
                     <TextField fx:id="txtPlcRack" maxWidth="Infinity" />
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label text="Slot" styleClass="rotulo" />
                     <TextField fx:id="txtPlcSlot" maxWidth="Infinity" />
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label text="DB" styleClass="rotulo" />
                     <TextField fx:id="txtPlcDb" maxWidth="Infinity" />
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label text="Intervalo (ms)" styleClass="rotulo" />
                     <TextField fx:id="txtPlcIntervalo" maxWidth="Infinity" />
                  </VBox>
               </HBox>

                <CheckBox fx:id="chkPlcTsap" text="LOGO! / conexão por TSAP" />
                <HBox spacing="10.0">
                   <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                      <Label text="TSAP local (Desktop)" styleClass="rotulo" />
                      <TextField fx:id="txtPlcTsapLocal" promptText="03.00" maxWidth="Infinity" />
                   </VBox>
                   <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                      <Label text="TSAP remoto (LOGO!)" styleClass="rotulo" />
                      <TextField fx:id="txtPlcTsapRemoto" promptText="02.00" maxWidth="Infinity" />
                   </VBox>
                </HBox>
                <Label styleClass="ajuda" wrapText="true"
                       text="No LOGO!Soft Comfort, configure uma conexão Servidor S7. O TSAP local do Desktop deve ser igual ao remoto do LOGO, e vice-versa. Use os valores configurados no equipamento. A memória V é lida no DB1. Salve e reconecte o PLC após alterar a conexão." />
                <Label fx:id="lblConexaoStatus" styleClass="ajuda" wrapText="true" />
            </VBox>

            <!-- ================= Broker MQTT ================= -->
            <VBox fx:id="cartaoMqtt" spacing="12.0" styleClass="cartao"
                  GridPane.columnIndex="1" GridPane.rowIndex="0">
               <Label text="Broker MQTT de telemetria" styleClass="cartao-titulo" />
               <Label styleClass="cartao-nota"
                      text="Caminho do histórico: as leituras vão ao broker e são gravadas no InfluxDB." />

               <CheckBox fx:id="chkTelemetriaMqtt" text="Publicar telemetria MQTT" />
               <Label styleClass="ajuda"
                      text="Desmarcado, esta estação para de publicar no broker e não alimenta o histórico no InfluxDB. Continuam funcionando a leitura do CLP, a tela, o histórico local e o alarme desta estação." />

               <VBox spacing="5.0">
                  <Label text="Usuário" styleClass="rotulo" />
                  <TextField fx:id="txtTelemetriaUsuario" promptText="Vazio se o broker não exigir autenticação" maxWidth="Infinity" />
               </VBox>

               <VBox spacing="5.0">
                  <Label text="Senha" styleClass="rotulo" />
                  <PasswordField fx:id="txtTelemetriaSenha" promptText="Senha do broker" maxWidth="Infinity" />
               </VBox>
            </VBox>

            <!-- ================= Tempo real ================= -->
            <VBox fx:id="cartaoTempoReal" spacing="12.0" styleClass="cartao"
                  GridPane.columnIndex="0" GridPane.rowIndex="1">
               <Label text="Tempo real (Geopetro-Backend)" styleClass="cartao-titulo" />
               <Label styleClass="cartao-nota"
                      text="Caminho do tempo real: o estado atual vai ao backend por WebSocket e é retransmitido a quem tem acesso. Nada é gravado." />

               <CheckBox fx:id="chkTempoReal" text="Publicar em tempo real (WebSocket)" />
               <Label styleClass="ajuda"
                      text="Desmarcado, esta unidade some da tela remota e o servidor deixa de avaliar alarmes dela. O alarme desta estação continua funcionando, e os cards já baixados continuam desenhando." />

               <VBox spacing="5.0">
                  <Label text="Usuário de serviço" styleClass="rotulo" />
                  <TextField fx:id="txtBackendUsuario" promptText="Usuário desta sonda no backend" maxWidth="Infinity" />
               </VBox>

               <VBox spacing="5.0">
                  <Label text="Senha" styleClass="rotulo" />
                  <PasswordField fx:id="txtBackendSenha" promptText="Senha do usuário de serviço" maxWidth="Infinity" />
               </VBox>

               <Label styleClass="ajuda"
                      text="Estas credenciais são exclusivas da transmissão automática em tempo real. Buscar e configurar Unidades reutiliza a sessão ADMIN ou SUPORTE já autenticada." />
            </VBox>

            <!--
               "Cards visiveis no monitoramento" saiu daqui em 2026-09-10
               (configuracao-da-estacao.md §4). Eram seis checkboxes das grandezas fixas de antes
               dos cards configuraveis, e com cards por unidade a lista nem descrevia mais o que a
               unidade tem.

               ⚠️ E ja nao faziam nada: CardVisibilityConfig era lido e escrito SOMENTE por esta
               tela. Quem decide o que aparece e ativo/visivel no documento de cards.

               ⚠️ O rotulo mentia — dizia "Cards desmarcados ficam ocultos e nao salvam dados", e
               nenhuma das duas coisas acontecia. Quem desmarcasse iria procurar o efeito, nao
               achar, e desconfiar do resto da configuracao.
            -->

         </GridPane>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rodape">
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="btnCancel" text="Cancelar" styleClass="botao-secundario" />
         <Button fx:id="btnSave" text="Salvar" styleClass="botao-primario" defaultButton="true" />
      </HBox>
   </bottom>

</BorderPane>
