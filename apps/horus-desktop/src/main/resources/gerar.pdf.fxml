<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="14.0"
      stylesheets="@geopetro-design-system.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.braservhorusdesktop.controller.GerarPdfController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="titulo-tela" text="Gerar Relatório em PDF" />

    <GridPane hgap="10.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="320.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Label styleClass="rotulo-campo" text="Nome do Poço:" />
        <TextField fx:id="nomePocoDespField" GridPane.columnIndex="1" />

        <Label styleClass="rotulo-campo" text="Data Início:" GridPane.rowIndex="1" />
        <DatePicker fx:id="dataInicioField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="rotulo-campo" text="Data Fim:" GridPane.rowIndex="2" />
        <DatePicker fx:id="dataFimField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="rotulo-campo" text="Hora Início:" GridPane.rowIndex="3" />
        <TextField fx:id="horaInicioField" promptText="HH:mm:ss" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="rotulo-campo" text="Hora Fim:" GridPane.rowIndex="4" />
        <TextField fx:id="horaFimField" promptText="HH:mm:ss" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label styleClass="rotulo-campo" text="Pressão em:" GridPane.rowIndex="5" />
        <ComboBox fx:id="unidadePressaoCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
           text="Os registros são gravados em PSI. A conversão acontece agora, ao desenhar os gráficos." />

    <!--
       Area de progresso: fica oculta ate a geracao comecar e ocupa espaco zero enquanto isso
       (managed=false), para nao abrir um vao na tela.
    -->
    <VBox fx:id="progressoBox" spacing="6.0" visible="false" managed="false">
        <Label fx:id="progressoLabel" styleClass="ajuda" text="" />
        <ProgressBar fx:id="progressoBar" maxWidth="Infinity" progress="0.0" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelar"
                styleClass="botao-secundario" text="Cancelar" />
        <Button fx:id="btnGerar" mnemonicParsing="false" onAction="#onGerarPdf"
                styleClass="botao-primario" text="Gerar PDF" defaultButton="true" />
    </HBox>

</VBox>
