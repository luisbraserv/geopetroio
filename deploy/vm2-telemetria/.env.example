# =====================================================================
# VM-2 · TELEMETRIA — copie para .env e preencha.
# NAO versione o .env: ele contem credenciais.
# =====================================================================

TAG=latest

# --- MQTT ---------------------------------------------------------
# Usadas pelo broker E pelo consumidor. O arquivo mosquitto/passwd
# precisa ser gerado com estas credenciais — ver README.
MQTT_USERNAME=telemetria
MQTT_PASSWORD=

# --- InfluxDB -----------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
# Token de acesso do consumidor. Gere com: openssl rand -hex 32
INFLUX_TOKEN=
INFLUX_ORG=braserv
INFLUX_BUCKET=telemetria
# Retencao do dado bruto. Ver OQ-028 antes de escolher.
INFLUX_RETENTION=90d

# --- Aplicacao ----------------------------------------------------
TELEMETRIA_ZONA_SONDA=America/Sao_Paulo
TELEMETRIA_MAX_PONTOS=2000
LOG_LEVEL=INFO
