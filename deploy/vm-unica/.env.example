# =====================================================================
# VM UNICA · PRODUCAO — copie para .env e preencha.
# NAO versione o .env: ele contem credenciais.
# Gere cada segredo na propria VM (comandos ao lado); nao reaproveite
# os valores de desenvolvimento.
# =====================================================================

TAG=latest

# --- Dominio e TLS ------------------------------------------------
DOMINIO=geopetro.braservpetroleo.com.br
# E-mail do Let's Encrypt (avisos de expiracao).
ACME_EMAIL=

# Portas no host. Mude so se a VM ja usa alguma delas; o Let's Encrypt
# precisa da 80 externa chegando ao caddy.
HTTP_PORT=80
HTTPS_PORT=443
MQTT_PORT=1883

# --- MySQL --------------------------------------------------------
# Gere com: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
DB_NAME=geopetro_io
DB_USERNAME=geopetro
# Gere com: openssl rand -hex 24
DB_PASSWORD=

CORE_DB_NAME=braserv_core
CORE_DB_USERNAME=braserv_core
# Gere com: openssl rand -hex 24
CORE_DB_PASSWORD=

# --- Seguranca ----------------------------------------------------
# Credencial usada pelo backend para pedir tokens de servico ao core. O core
# grava somente o hash. Gere com: openssl rand -hex 32
CORE_CLIENTE_SEGREDO=
JWT_EXPIRATION_SECONDS=3600
# Caminhos internos de chaves publicas antigas, separados por virgula, durante
# uma rotacao. Normalmente fica vazio.
JWT_CHAVES_PUBLICAS_ANTERIORES=

# --- MQTT (broker e consumidor; as sondas usam as mesmas) ---------
MQTT_USERNAME=telemetria
# Gere com: openssl rand -hex 24
MQTT_PASSWORD=

# --- InfluxDB -----------------------------------------------------
INFLUX_ADMIN_USER=admin
# Gere com: openssl rand -hex 24
INFLUX_ADMIN_PASSWORD=
# Gere com: openssl rand -hex 32
INFLUX_TOKEN=
INFLUX_ORG=braserv
INFLUX_BUCKET=telemetria
# Ver OQ-028 antes de mudar.
INFLUX_RETENTION=90d

# --- Telemetria ---------------------------------------------------
TELEMETRIA_ZONA_SONDA=America/Sao_Paulo
TELEMETRIA_MAX_PONTOS=2000
LOG_LEVEL=INFO

# --- Memoria das JVMs (o heap e 75% disto) ------------------------
CORE_MEM=1024m
BACKEND_MEM=1536m
TELEMETRIA_MEM=768m

# --- Recuperacao de senha (SMTP) ----------------------------------
# Ative depois de configurar o remetente e validar a entrega. A URL do
# link de recuperacao sai do DOMINIO.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RECOVERY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# Opcional. Nao use outra credencial como chave. Nao altere sem recadastrar a senha SMTP.
SMTP_SETTINGS_ENCRYPTION_KEY=
