# =====================================================================
# VM-1 · TRANSACIONAL — copie para .env e preencha.
# NAO versione o .env: ele contem credenciais.
# =====================================================================

TAG=latest

# --- Rede ---------------------------------------------------------
# Porta externa do front. Na VM-1 a 80 pertence ao IIS, que continua no ar.
# Se mudar aqui, rode de novo o 03-publicar-portas.ps1 com -Porta igual.
FRONT_PORT=8090

# --- MySQL --------------------------------------------------------
MYSQL_ROOT_PASSWORD=
DB_NAME=geopetro_io
DB_USERNAME=geopetro
DB_PASSWORD=

# --- Seguranca ----------------------------------------------------
# Segredo de assinatura do JWT. Gere com: openssl rand -base64 48
# A aplicacao FALHA no startup se estiver vazio — de proposito.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# --- Integracao com a VM-2 (telemetria) ---------------------------
# IP ou hostname da VM de telemetria, alcancavel a partir desta VM.
TELEMETRIA_HOST_IP=10.0.0.20
MONITORAMENTO_BASE_URL=http://10.0.0.20:8081

# --- CORS ---------------------------------------------------------
# Origens do frontend em producao. Nao inclua *.trycloudflare.com aqui:
# aquele padrao existe so para tuneis de demonstracao em desenvolvimento.
CORS_ALLOWED_ORIGINS=https://geopetro-io.braserv.com.br
CORS_ALLOWED_ORIGIN_PATTERNS=https://geopetro-io.braserv.com.br
