# =====================================================================
# VM-1 · TRANSACIONAL — copie para .env e preencha.
# NAO versione o .env: ele contem credenciais.
# =====================================================================

TAG=latest

# --- Rede ---------------------------------------------------------
# Porta externa do front. Na VM-1 a 80 pertence ao IIS, que continua no ar.
# Se mudar aqui, rode de novo o 03-publicar-portas.ps1 com -Porta igual.
FRONT_PORT=8090

# --- MySQL --------------------------------------------------------
MYSQL_ROOT_PASSWORD=
DB_NAME=geopetro_io
DB_USERNAME=geopetro
DB_PASSWORD=

CORE_DB_NAME=braserv_core
CORE_DB_USERNAME=braserv_core
# Gere com: openssl rand -hex 24
CORE_DB_PASSWORD=

# --- Seguranca ----------------------------------------------------
# Credencial do backend no Core. O Core armazena somente o hash.
# Gere com: openssl rand -hex 32
CORE_CLIENTE_SEGREDO=
JWT_EXPIRATION_SECONDS=3600
JWT_CHAVES_PUBLICAS_ANTERIORES=

# --- Integracao com a VM-2 (telemetria) ---------------------------
# IP ou hostname da VM de telemetria, alcancavel a partir desta VM.
TELEMETRIA_HOST_IP=10.0.0.20
MONITORAMENTO_BASE_URL=http://10.0.0.20:8081

# --- CORS ---------------------------------------------------------
# Origens do frontend em producao. Nao inclua *.trycloudflare.com aqui:
# aquele padrao existe so para tuneis de demonstracao em desenvolvimento.
CORS_ALLOWED_ORIGINS=https://geopetro-io.braserv.com.br
CORS_ALLOWED_ORIGIN_PATTERNS=https://geopetro-io.braserv.com.br

# --- Recuperacao de senha (SMTP, somente identidade) -------------
# Ative depois de configurar o remetente e validar a entrega.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RECOVERY_FRONTEND_URL=https://geopetro-io.braserv.com.br
PASSWORD_RECOVERY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true

# SMTP pode ser configurado em Configuracoes > E-mail (ADMIN).
# A configuracao salva no banco prevalece sobre as variaveis SMTP acima.
# Chave gerada automaticamente no volume smtp-secrets; inclua esse volume no backup.
# Opcional: chave dedicada de 32 bytes em Base64 gerenciada externamente.
# Nao altere a chave sem recadastrar a senha SMTP.
SMTP_SETTINGS_ENCRYPTION_KEY=
