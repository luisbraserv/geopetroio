<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
   Cards da unidade — passo 6 de specs/features/cards-configuraveis.md.

   Lista a esquerda, formulario do card selecionado a direita. Os parametros mudam com o tipo: cada
   tipo tem seu painel, e o controller mostra um de cada vez. Peso e torque exibem o range do
   transmissor; a geometria e a sensibilidade ficam na calibracao local por dispositivo.

   Rodape fixo, como em settings.fxml: com os botoes dentro da area rolavel, "Salvar" saia de vista
   assim que a janela encolhia.

   ⚠️ Esta tela NAO le o CLP enquanto se digita (decisao de 2026-09-07, §10). Salva-se e confere-se
   no dashboard, onde o valor bruto de cada card revela canal mudo ou escala inesperada.
-->
<VBox fx:id="raiz" prefWidth="1040.0" prefHeight="700.0"
      stylesheets="@geopetro-design-system.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controllers.CardsConfigController">

   <!-- ===================== Cabecalho ===================== -->
   <VBox spacing="2.0" styleClass="cabecalho">
      <Label fx:id="lblTitulo" text="Cards da unidade" styleClass="cabecalho-titulo" />
      <Label fx:id="lblSubtitulo" styleClass="cabecalho-subtitulo"
             text="O que esta unidade lê no CLP, com que conversão e com que nome na tela." />
   </VBox>

   <SplitPane fx:id="divisor" dividerPositions="0.5" VBox.vgrow="ALWAYS">

      <!-- ===================== Lista ===================== -->
      <VBox spacing="10.0" minWidth="0.0" prefWidth="200.0">
         <padding><Insets top="14.0" right="12.0" bottom="14.0" left="14.0" /></padding>

         <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label text="Cards" styleClass="cartao-titulo" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCopiar" text="Copiar de outra unidade" styleClass="botao-fantasma" />
         </HBox>

         <!--
            A politica de redimensionamento e definida no controller: as colunas dividem a largura
            disponivel em vez de somarem uma largura fixa maior que o painel.
         -->
         <TableView fx:id="tabela" VBox.vgrow="ALWAYS" minWidth="0.0" prefWidth="200.0">
            <columns>
               <TableColumn fx:id="colIdentificacao" text="Dispositivo" prefWidth="128.0" minWidth="80.0" />
               <TableColumn fx:id="colNome" text="Nome na tela" prefWidth="130.0" minWidth="80.0" />
               <TableColumn fx:id="colTipo" text="Tipo" prefWidth="96.0" minWidth="60.0" />
               <TableColumn fx:id="colEndereco" text="Endereço" prefWidth="72.0" minWidth="56.0" />
               <TableColumn fx:id="colEstado" text="Estado" prefWidth="76.0" minWidth="60.0" />
            </columns>
         </TableView>

         <HBox spacing="8.0">
            <Button fx:id="btnAdicionar" text="Adicionar" styleClass="botao-secundario" />
            <Button fx:id="btnSubir" text="↑" styleClass="botao-fantasma" />
            <Button fx:id="btnDescer" text="↓" styleClass="botao-fantasma" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- Nao ha "Excluir": card se desativa, nunca se exclui — RN-091. -->
            <Button fx:id="btnAlternarAtivo" text="Desativar" styleClass="botao-perigo" />
         </HBox>

         <Label styleClass="ajuda" text="Card não se exclui — apenas se desativa (RN-091)." />
      </VBox>

      <!-- ===================== Formulario ===================== -->
      <ScrollPane fitToWidth="true" styleClass="area-rolagem" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
         <VBox fx:id="painelCard" spacing="14.0">
            <padding><Insets top="14.0" right="16.0" bottom="14.0" left="14.0" /></padding>

            <Label fx:id="lblSemSelecao" styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                   text="Selecione um card na lista, ou use Adicionar para criar o primeiro." />

            <VBox fx:id="formulario" spacing="14.0" visible="false" managed="false">

               <VBox spacing="5.0">
                  <Label text="Nome na tela" styleClass="rotulo" />
                  <TextField fx:id="txtNome" promptText="Ex.: Bomba de Lama" maxWidth="Infinity" />
                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="Rótulo editável. Não entra no histórico — quem identifica a série é o dispositivo." />
               </VBox>

               <GridPane hgap="12.0" vgap="5.0">
                  <columnConstraints>
                     <ColumnConstraints percentWidth="50.0" />
                     <ColumnConstraints percentWidth="50.0" />
                  </columnConstraints>

                  <Label text="Tipo" styleClass="rotulo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbTipo" maxWidth="Infinity"
                            GridPane.columnIndex="0" GridPane.rowIndex="1" />

                  <Label text="Byte inicial no DB" styleClass="rotulo"
                         GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <TextField fx:id="txtByteInicial" promptText="Ex.: 10"
                             GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </GridPane>

               <Label fx:id="lblEndereco" styleClass="mono"
                      text="DBW10 · 2 bytes" />
               <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                      text="O tamanho vem do tipo e não se escolhe: ler dois bytes de um contador de quatro devolve um número plausível e errado." />

               <HBox spacing="18.0">
                  <CheckBox fx:id="chkAtivo" text="Ativo" />
                  <CheckBox fx:id="chkVisivel" text="Visível no dashboard" />
               </HBox>

               <!--
                  OQ-050: card ativo e invisivel e lido e gravado aqui, e NAO chega ao servidor
                  (RN-037). Como a avaliacao remota roda sobre o tempo real (RN-102), o limite de
                  alarme dele nunca dispara para a supervisao. Quem desmarca precisa saber disso.
                  O controller mostra e esconde conforme os dois checkboxes.
               -->
               <Label fx:id="lblAvisoInvisivel" styleClass="aviso-configuracao" wrapText="true"
                      maxWidth="Infinity" managed="false" visible="false" />

               <Separator />

               <!-- ===== Parametros por tipo: o controller mostra um de cada vez ===== -->

               <!-- O range do transmissor vale para pressao, peso e torque. A geometria e local. -->
               <VBox fx:id="paramPressao" spacing="5.0" visible="false" managed="false">
                  <Label text="Range do sensor (bar)" styleClass="rotulo" />
                  <TextField fx:id="txtRangeBar" promptText="Ex.: 250" maxWidth="Infinity" />
                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="Fundo de escala do transmissor 4-20 mA. 4 mA é zero; 20 mA é este valor." />
               </VBox>

               <!-- Calibracao medida nesta estacao, individual para cada dispositivo. -->
               <VBox fx:id="paramCalibracaoLocal" spacing="8.0" visible="false" managed="false">
                  <Label fx:id="lblCalibracaoAlvo" text="Calibração" styleClass="rotulo" />
                  <Label fx:id="lblCalibracaoValores" styleClass="mono" wrapText="true" maxWidth="Infinity" />
                  <Label fx:id="lblCalibracaoEstado" styleClass="ajuda" wrapText="true" maxWidth="Infinity" />
                  <HBox spacing="8.0">
                     <Button fx:id="btnAbrirCalibracao" text="Abrir calibração" styleClass="botao-secundario" />
                  </HBox>
                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="A escala do sensor fica no card. A calibração mecânica e a sensibilidade ficam nesta estação, separadas por dispositivo. A engrenagem do card abre os mesmos ajustes." />
               </VBox>

               <VBox fx:id="paramTemperatura" spacing="10.0" visible="false" managed="false">
                  <GridPane hgap="12.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="34.0" />
                        <ColumnConstraints percentWidth="33.0" />
                        <ColumnConstraints percentWidth="33.0" />
                     </columnConstraints>
                     <Label text="Mínimo da escala" styleClass="rotulo"
                            GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <TextField fx:id="txtMinimoEscala" promptText="Ex.: -20"
                                GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <Label text="Máximo" styleClass="rotulo"
                            GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <TextField fx:id="txtMaximoEscala" promptText="Ex.: 150"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label text="Unidade" styleClass="rotulo"
                            GridPane.columnIndex="2" GridPane.rowIndex="0" />
                     <ComboBox fx:id="cbUnidadeTemperatura" maxWidth="Infinity"
                               GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  </GridPane>
                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="4 mA corresponde ao mínimo e 20 mA ao máximo. A escala é a do transmissor, não a faixa de operação esperada." />
               </VBox>

               <VBox fx:id="paramTanque" spacing="10.0" visible="false" managed="false">
                  <VBox spacing="5.0">
                     <Label text="Forma do tanque" styleClass="rotulo" />
                     <ComboBox fx:id="cbFormaTanque" maxWidth="Infinity" />
                  </VBox>

                  <GridPane hgap="12.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <VBox fx:id="campoRaio" spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Raio (m)" styleClass="rotulo" />
                        <TextField fx:id="txtRaio" promptText="Ex.: 1.5" />
                     </VBox>
                     <VBox fx:id="campoAltura" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Altura (m)" styleClass="rotulo" />
                        <TextField fx:id="txtAltura" promptText="Ex.: 3.0" />
                     </VBox>
                     <VBox fx:id="campoComprimento" spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Comprimento (m)" styleClass="rotulo" />
                        <TextField fx:id="txtComprimento" promptText="Ex.: 6.0" />
                     </VBox>
                     <VBox fx:id="campoLargura" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Largura (m)" styleClass="rotulo" />
                        <TextField fx:id="txtLargura" promptText="Ex.: 2.0" />
                     </VBox>
                  </GridPane>

                  <GridPane hgap="12.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <Label text="Distância mínima (m)" styleClass="rotulo"
                            GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <TextField fx:id="txtDistanciaMinima" promptText="Ex.: 0.20"
                                GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <Label text="Distância máxima (m)" styleClass="rotulo"
                            GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <TextField fx:id="txtDistanciaMaxima" promptText="Ex.: 2.90"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  </GridPane>

                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="O sensor fica sempre no topo e mede a distância até o líquido: a distância mínima é com o tanque cheio, e a máxima com ele vazio." />
               </VBox>

               <VBox fx:id="paramStroke" spacing="5.0" visible="false" managed="false">
                  <Label text="Constante da bomba (bbl/stroke)" styleClass="rotulo" />
                  <TextField fx:id="txtConstanteBomba" promptText="Ex.: 0.125" maxWidth="Infinity" />
                  <Label styleClass="ajuda" wrapText="true" maxWidth="Infinity"
                         text="Cada bomba tem a sua. Deste card saem stroke atual, bbl/min e o volume acumulado da bomba." />
               </VBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </SplitPane>

   <!--
      O painel de conexao com o CLP saiu daqui em 2026-09-10 e foi para a engrenagem
      (configuracao-da-estacao.md §4). Esta tela trata so de CARDS: nome, tipo, byte inicial,
      ativo, visivel e parametros.

      ⚠️ A conexao continua no MESMO documento, e por isso salvar aqui a devolve como o servidor a
      tem neste instante — ver ConfiguracaoCardsClient.salvarCards.
   -->

   <!-- ===================== Rodape fixo ===================== -->
   <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="rodape">
      <padding><Insets top="12.0" right="16.0" bottom="12.0" left="16.0" /></padding>
      <Label fx:id="lblStatus" styleClass="ajuda" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <Button fx:id="btnRecarregar" text="Recarregar" styleClass="botao-fantasma" />
      <Button fx:id="btnFechar" text="Fechar" styleClass="botao-secundario" cancelButton="true" />
      <Button fx:id="btnSalvar" text="Salvar" styleClass="botao-primario" defaultButton="true" />
   </HBox>
</VBox>
