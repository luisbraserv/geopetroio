<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
   Calibracao do card de peso. Cabecalho e rodape fixos, miolo rolavel: range, geometria e
   diagnostico, e com os botoes dentro da area rolavel "Salvar" sairia de vista.
-->
<BorderPane prefWidth="560.0" prefHeight="640.0"
            stylesheets="@geopetro-design-system.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.PesoColunaSettingsController">

   <top>
      <VBox spacing="3.0" styleClass="cabecalho">
         <Label fx:id="lblTitulo" text="Peso da Coluna — geometria do sargento" styleClass="cabecalho-titulo" />
         <Label styleClass="cabecalho-subtitulo" wrapText="true"
                text="O sensor mede a pressão no sargento, não o peso no gancho. A conversão percorre força, torque, tração da linha morta e número de linhas." />
      </VBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" styleClass="area-rolagem" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
         <VBox spacing="14.0">
            <padding><Insets top="18.0" right="24.0" bottom="18.0" left="24.0" /></padding>

            <Label text="Sensor hidráulico" styleClass="cartao-titulo" />

            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="180.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>

               <Label text="Range do sensor (bar)" styleClass="rotulo" GridPane.rowIndex="0" />
               <TextField fx:id="txtRangeBar" promptText="Ex.: 250" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" />

               <Label text="Pressão zero (psi)" styleClass="rotulo" GridPane.rowIndex="1" />
               <TextField fx:id="txtPressaoZero" promptText="Ex.: 0.0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" />

               <Label text="Área efetiva do sensor (pol²)" styleClass="rotulo" GridPane.rowIndex="2" />
               <TextField fx:id="txtAreaEfetiva" promptText="Ex.: 10.0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="2" />

               <Label text="Braço do sensor (pol)" styleClass="rotulo" GridPane.rowIndex="3" />
               <TextField fx:id="txtBracoSensor" promptText="Ex.: 12.0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <VBox spacing="4.0">
               <HBox spacing="8.0">
                  <Label text="Sensibilidade do sensor:" styleClass="rotulo" />
                  <Label fx:id="lblSensibilidade" text="1.000" styleClass="rotulo" />
               </HBox>
               <Slider fx:id="sliderSensibilidade" min="0.5" max="1.5" value="1.0"
                       majorTickUnit="0.25" minorTickCount="4" blockIncrement="0.005"
                       showTickLabels="true" showTickMarks="true" />
            </VBox>

            <Label styleClass="ajuda" wrapText="true"
                   text="Pressão zero é apenas o offset do sensor — não use para descontar a Catarina, que entra no fim da conta. O braço é a distância entre o eixo do tambor e a linha de atuação da força." />

            <Separator />

            <Label text="Tambor e cabo" styleClass="cartao-titulo" />

            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="180.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>

               <Label text="Diâmetro do tambor (pol)" styleClass="rotulo" GridPane.rowIndex="0" />
               <TextField fx:id="txtDiametroTambor" promptText="Ex.: 30.0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" />

               <Label text="Diâmetro do cabo (pol)" styleClass="rotulo" GridPane.rowIndex="1" />
               <TextField fx:id="txtDiametroCabo" promptText="Ex.: 1.0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" />

               <Label text="Número de linhas" styleClass="rotulo" GridPane.rowIndex="2" />
               <TextField fx:id="txtNumeroLinhas" promptText="Ex.: 8" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <Label styleClass="ajuda" wrapText="true"
                   text="O diâmetro do cabo entra no braço, não na área: a tração age na linha de centro do cabo, então o raio efetivo é (tambor + cabo) / 2." />

            <Separator />

            <Label text="Conjunto móvel e calibração" styleClass="cartao-titulo" />

            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="180.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>

               <Label text="Peso da Catarina (lbf)" styleClass="rotulo" GridPane.rowIndex="0" />
               <TextField fx:id="txtPesoCatarina" promptText="Ex.: 12000" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </GridPane>

            <VBox spacing="4.0">
               <HBox spacing="8.0">
                  <Label text="Fator de calibração:" styleClass="rotulo" />
                  <Label fx:id="lblFatorCalibracao" text="1.000" styleClass="rotulo" />
               </HBox>
               <Slider fx:id="sliderFatorCalibracao" min="0.5" max="1.5" value="1.0"
                       majorTickUnit="0.25" minorTickCount="4" blockIncrement="0.005"
                       showTickLabels="true" showTickMarks="true" />
               <Label styleClass="ajuda" wrapText="true"
                      text="Ajuste contra carga conhecida, depois de conferir a geometria. Um fator muito longe de 1,0 indica parâmetro físico errado, não falta de calibração." />
            </VBox>

            <Separator />

            <!-- Diagnóstico: mostra onde a conta se afasta da carga conhecida durante a calibração. -->
            <Label text="Cálculo com a leitura atual" styleClass="cartao-titulo" />
            <VBox fx:id="boxDiagnostico" spacing="3.0" styleClass="cartao-muted">
               <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0" /></padding>
               <Label fx:id="lblDiagnostico" styleClass="ajuda" wrapText="true"
                      text="Configure a geometria para ver o passo a passo." />
            </VBox>

         </VBox>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="rodape">
         <Label fx:id="lblStatus" styleClass="ajuda" wrapText="true" HBox.hgrow="ALWAYS" />
         <Button fx:id="btnCancelar" prefWidth="110.0" text="Cancelar"
                 styleClass="botao-secundario" onAction="#onCancelar" />
         <Button fx:id="btnSalvar" prefWidth="110.0" text="Salvar" defaultButton="true"
                 styleClass="botao-primario" onAction="#onSalvar" />
      </HBox>
   </bottom>

</BorderPane>
